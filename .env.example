ANTHROPIC_API_KEY=your_api_key_here

# ── PhotoAgent (Ollama + Stable Diffusion Forge) ──────────────────────────────

# Ollama — локальная LLM для оркестрации (без API-ключей)
# Модели с tool calling: llama3.1, llama3.2, mistral-nemo, qwen2.5
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# Forge — запустить с флагом --api: python launch.py --api
PHOTO_BACKEND=forge
PHOTO_API_URL=http://127.0.0.1:7860
PHOTO_OUTPUT_DIR=./outputs

# ── YoutuberAgent (browser automation) ───────────────────────────────────────
YOUTUBE_EMAIL=you@example.com
YOUTUBE_PASSWORD=your_password_here
YOUTUBER_USER_DATA_DIR=./.yt_profile
YOUTUBER_HEADLESS=false
